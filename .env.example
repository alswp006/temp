# 식판 (Sikpan) — 환경 변수
# cp .env.example .env  후 필요한 값만 채우십시오. 전부 비워도 stub 모드로 동작합니다.

# --- core -----------------------------------------------------------------
ENV=dev                                   # dev | test | prod
BASE_URL=http://localhost:8000
# 반드시 프로덕션에서 교체하십시오. 비워두면 재시작마다 새로 생성되어 모든 토큰이 무효화됩니다.
SECRET_KEY=

# --- database -------------------------------------------------------------
# Phase 1 (1인용):
DATABASE_URL=sqlite+aiosqlite:///./sikpan.db
# Phase 2+ (여러 명):
# DATABASE_URL=postgresql+asyncpg://sikpan:sikpan@localhost:5432/sikpan

# --- auth -----------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=20160            # 14일
# dev에서만 true. 로그인 코드를 API 응답에 그대로 실어 줍니다(SMTP 불필요).
EXPOSE_LOGIN_CODE=true

# --- vision ---------------------------------------------------------------
# stub | anthropic | gemini
VISION_PROVIDER=stub

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low가 기본. 후보 목록이 주어진 식판 판독은 추론 부하가 낮고, 끼니마다 도는 비용 지점입니다.
ANTHROPIC_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VISION_TIMEOUT_S=60

# --- 인식 호출 정책 --------------------------------------------------------
# 그 (식당, 날짜, 끼니) 슬롯을 처음 찍는 사람이 내는 호출 수
RECOGNITION_K_COLD=5
# 기준 해석이 이미 있을 때
RECOGNITION_K_WARM=1
# 기준과 어긋날 때 추가로 도는 호출 수
RECOGNITION_K_ESCALATE=3
RECOGNITION_AGREEMENT_TOLERANCE=0.35

# --- storage / privacy ----------------------------------------------------
MEDIA_ROOT=./var/media
MAX_UPLOAD_BYTES=12582912
PHOTO_MAX_EDGE=1568
# true면 분석 직후 원본 사진을 삭제합니다.
DISCARD_PHOTO_AFTER_ANALYSIS=false

# --- targets --------------------------------------------------------------
WEIGHT_TREND_ALPHA=0.1
TDEE_CLAMP_RATIO=0.15
PROTEIN_G_PER_KG=1.8

# --- worker ---------------------------------------------------------------
# prod에서는 false로 두고 `python -m app.jobs.worker`를 별도 프로세스로 띄우십시오.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_S=1.0
JOB_MAX_ATTEMPTS=4

# --- integrations ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
